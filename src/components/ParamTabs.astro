---
/**
 * URL Parameter-Aware Tabs
 *
 * Wraps Astro Starlight's Tabs component to enable tab selection via URL parameters.
 *
 * Example:
 *
 *   <ParamTabs param="lang" syncKey="key">
 *     <TabItem label="Node">Node content</TabItem>
 *     <TabItem label="Java">Java content</TabItem>
 *   </ParamTabs>
 *
 *  The "Node" labeled tab can now be selected using `https://glide.valkey.io/page?lang=node`.
 *  The component will maps the param's value to a tab's label. To provide a specify specific
 *  mapping, pass in an alias mapping of <label, alias>.
 *
 *  To provide keep tabs in sync with other tabs, use `syncKey`.
 */
import { Tabs } from "@astrojs/starlight/components";

interface Props {
    /* A mapping of <label, alias> */
    aliases?: Readonly<Record<string, string>>;
    param?: string;
    syncKey?: string;
}

const { aliases = {}, param: paramName = "", ...tabsProps } = Astro.props;
---

{
    paramName ? (
        <div
            class="param-tabs"
            data-param={paramName}
            data-aliases={JSON.stringify(aliases)}
        >
            <Tabs {...tabsProps}>
                <slot />
            </Tabs>
        </div>
    ) : (
        <Tabs {...tabsProps}>
            <slot />
        </Tabs>
    )
}

<script>
    await customElements.whenDefined("starlight-tabs");

    const paramTabs = document.querySelectorAll(".param-tabs");

    paramTabs.forEach((wrapper) => {
        const paramKey = (wrapper as HTMLElement).dataset.param;
        if (!paramKey) {
            return;
        }

        const urlParams = new URLSearchParams(window.location.search);
        const targetValue = urlParams.get(paramKey);

        if (!targetValue) return;

        const aliases = JSON.parse(wrapper.dataset.aliases ?? "{}") as Record<
            string,
            string
        >;
        const targetLabel = targetValue.toLowerCase();
        const requestedLabel = (
            aliases[targetLabel] ?? targetLabel
        ).toLowerCase();

        const tabs = wrapper.querySelectorAll('[role="tab"]');

        for (const tab of tabs) {
            const label = tab.textContent?.trim().toLowerCase();

            if (label === requestedLabel) {
                // Wait on the next animation frame to ensure Starlight Tabs is ready
                requestAnimationFrame(() => {
                    const element = tab as HTMLElement;
                    element.click();
                    element.blur();
                });
                break;
            }
        }
    });
</script>
